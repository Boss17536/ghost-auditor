GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
SECRET_KEY=any-random-string-for-flask-sessions

# TinyFish API Key (Required for live agent runs)
TINYFISH_API_KEY=your-own-key-for-testing-only

# Encryption Key (Used for encrypting API keys/cookies in the local DB)
# Must be 32 url-safe base64 bytes. For development, a fallback is used if missing.
# Example generated via: cryptography.fernet.Fernet.generate_key()
# ENCRYPTION_KEY=xO0-vA9FhIwv7J-_pZ3W2zQXo-9aE80wO65hC3vQGk4=

# Flask app port
PORT=5000
